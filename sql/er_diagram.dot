digraph ER {
rankdir=LR; splines=polyline; nodesep=0.5; ranksep=1.0; bgcolor="white";
node [shape=plain, fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=9, color="#666666", arrowhead=crow, arrowtail=tee, dir=both];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><B>category_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(60)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
suppliers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>suppliers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id"><B>supplier_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(60)</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
medicines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>medicines</B></TD></TR><TR><TD ALIGN="LEFT" PORT="medicine_id"><B>medicine_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="generic_name">generic_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="manufacturer">manufacturer</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="reorder_level">reorder_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="requires_prescription">requires_prescription</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
batches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>batches</B></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id"><B>batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="medicine_id">medicine_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id">supplier_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_no">batch_no</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_in_stock">quantity_in_stock</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_price">purchase_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="received_date">received_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="expiry_date">expiry_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>customer_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_on">registered_on</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
staff [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>staff</B></TD></TR><TR><TD ALIGN="LEFT" PORT="staff_id"><B>staff_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hired_on">hired_on</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
sales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>sales</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><B>sale_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="staff_id">staff_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_date">sale_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="payment_mode">payment_mode</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(10)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount">total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
sale_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>sale_items</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_item_id"><B>sale_item_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id">sale_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">batch_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
purchase_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>purchase_orders</B></TD></TR><TR><TD ALIGN="LEFT" PORT="po_id"><B>po_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id">supplier_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date">order_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(10)</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
purchase_order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>purchase_order_items</B></TD></TR><TR><TD ALIGN="LEFT" PORT="po_item_id"><B>po_item_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="po_id">po_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="medicine_id">medicine_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="unit_cost">unit_cost</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">numeric</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
demand_forecasts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>demand_forecasts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="forecast_id"><B>forecast_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="medicine_id">medicine_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="forecast_month">forecast_month</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="predicted_qty">predicted_qty</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="method">method</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="generated_at">generated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
stock_alerts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#dbe7f5"><B>stock_alerts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_id"><B>alert_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="medicine_id">medicine_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1a5fb4">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_type">alert_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="message">message</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="resolved">resolved</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bool</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
customers -> sales;
categories -> medicines;
medicines -> batches;
suppliers -> batches;
staff -> sales;
sales -> sale_items;
batches -> sale_items;
suppliers -> purchase_orders;
purchase_orders -> purchase_order_items;
medicines -> purchase_order_items;
medicines -> demand_forecasts;
medicines -> stock_alerts;
}
